<div class="auth-card">

  <h1>
    Log in
  </h1>

  <%= form_for(resource,
      as: resource_name,
      url: session_path(resource_name)) do |f| %>

    <div class="form-group">

      <%= f.label :email %>

      <%= f.email_field :email,
          class: "form-control" %>

    </div>

    <div class="form-group">

      <%= f.label :password %>

      <%= f.password_field :password,
          class: "form-control" %>

    </div>

    <%= f.submit "ログイン",
        class: "btn btn-primary" %>

  <% end %>

  <%= render "devise/shared/links" %>

</div>