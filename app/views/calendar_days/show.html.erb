<div class="page-container day-page">

  <div class="page-title">
    <h1>
      <%= @date.strftime("%Y/%m/%d") %>
    </h1>

    <p class="page-subtitle">
      この日の予定
    </p>
  </div>

  <!-- この日のタスク一覧 -->
  <section class="card">

  <h2 class="card-title">
    📅 この日のタスク
  </h2>

  <%= render "tasks/task_list",
      tasks: @tasks %>

</section>

  <!-- タスク追加 -->
<section class="card">

  <h2 class="card-title">
    ➕ この日のタスクを追加
  </h2>

  <%= render "tasks/form",
    task: @task,
    scheduled_date: @date,
    hide_scheduled_date: true %>

</section>
</div>


