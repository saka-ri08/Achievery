<div class="page-container day-page">

  <div class="page-title">
    <h1>
      <%= @date.strftime("%Y/%m/%d") %>
    </h1>

    <p class="page-subtitle">
      この日の予定
    </p>
  </div>

  <!-- この日のタスク一覧 -->
  <section class="card">

  <h2 class="card-title">
    📅 この日のクエスト
  </h2>

   <h3>📋 未完了クエスト</h3>

    <%= render "tasks/task_list",
        tasks: @incomplete_tasks %>

    <details class="completed-tasks mt-4">
      <summary>
        📜 完了済みクエスト（<%= @completed_tasks.count %>件）
      </summary>

      <%= render "tasks/task_list",
          tasks: @completed_tasks %>
    </details>

</section>

  <!-- タスク追加 -->
<section class="card">

  <h2 class="card-title">
    ➕ この日のタスクを追加
  </h2>

  <%= render "tasks/form",
    task: @task,
    scheduled_date: @date,
    hide_scheduled_date: true %>

</section>
</div>


