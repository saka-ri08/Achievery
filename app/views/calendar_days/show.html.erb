<h1><%= @date.strftime("%Y/%m/%d") %></h1>

<% if @tasks.any? %>

  <ul>

    <% @tasks.each do |task| %>

      <li>

        <% if task.completed? %>

          <span style="text-decoration: line-through;">
            <%= task.title %>
          </span>

        <% else %>

          <%= task.title %>

          <%= button_to "完了",
              task_path(task),
              method: :patch %>

          <%= button_to "削除",
              task_path(task),
              method: :delete %>

        <% end %>

      </li>

    <% end %>

  </ul>

<% else %>

  <p>この日のタスクはありません。</p>

<% end %>


<h3>タスクを追加</h3>

<%= form_with model: @task do |f| %>

  <%= f.text_field :title %>

  <%= f.hidden_field :scheduled_date,
      value: @date %>

  <%= f.submit "追加" %>

<% end %>

