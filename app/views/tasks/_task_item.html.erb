<div class="task-item">

  <div class="task-info">

    <div class="task-title">
      <%= task.title %>

      <span class="badge <%= task.priority_class %>">
       <%= task.priority_label %>
      </span>
    </div>

   <% if task.deadline.present? %>

    <span
      class="deadline-badge <%= task.deadline_class %>">

     <%= task.deadline_label %>

    </span>

   <% end %>

  </div>

  <div class="task-actions">

    <% unless task.completed? %>

      <%= button_to "✓",
       complete_task_path(task),
       method: :patch,
       class: "btn btn-success" %>

    <% end %>

    <%= button_to "削除",
      task_path(task),
      method: :delete,
      class: "btn btn-danger" %>

  </div>

</div>