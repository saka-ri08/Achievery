<li class="task-item">

  <div class="task-title">
    <%= task.title %>

    <span class="badge <%= task.priority_class %>">
      <%= task.priority_label %>
    </span>
  </div>

  <% if task.deadline.present? %>
    <span class="deadline-badge <%= task.deadline_class %>">
      <%= task.deadline_label %>
    </span>
  <% end %>

  <% unless task.completed? %>

    <%= button_to "完了",
      complete_task_path(task),
      method: :patch,
      class: "btn btn-success complete-btn" %>

  <% end %>

  <%= button_to "削除",
   task_path(task),
   method: :delete,
   class: "btn delete-btn" %>

</li>