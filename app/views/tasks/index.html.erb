<div class="page-container tasks-page">

  <div class="page-title">

    <h1>
      Tasks
    </h1>

    <p class="page-subtitle">
      今日のメインクエスト
    </p>

  </div>

  
  <section class="card">

  <h2 class="card-title">
    🔥 締切が近いタスク
  </h2>

  <%= render "task_list",
      tasks: @urgent_tasks %>

</section>

</section>

<section class="card">

  <h2 class="card-title">
    📋 その他のタスク
  </h2>

  <%= render "task_list",
      tasks: @other_tasks %>

</section>

<section class="card">

  <h2 class="card-title">
    ➕ タスク追加
  </h2>

  <%= render "form",
      task: @task %>

</section>