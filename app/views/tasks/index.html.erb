<div class="page-container">

  <div class="page-title">
    <h1>Tasks</h1>
    <p class="page-subtitle">
      今日のメインクエスト
    </p>
  </div>

      <div class="priority-guide mt-2">
       <p class="mb-1"><strong>📜 冒険者の手引き</strong></p>
       <ul class="mb-0">
        <li>👑 <strong>Boss</strong>：最優先で挑みたいクエスト</li>
        <li>⚔️ <strong>Normal</strong>：通常のクエスト</li>
        <li>🌱 <strong>Easy</strong>：余裕があるときに進めるクエスト</li>
       </ul>
      </div>

  <section class="card">

  <h2 class="card-title">
    🔥 締切が近いタスク
  </h2>

  <%= render "task_list",
      tasks: @urgent_tasks %>

</section>

</section>

<section class="card">

  <h2 class="card-title">
    📋 その他のタスク
  </h2>

  <%= render "task_list",
      tasks: @other_tasks %>

</section>

<section class="card">

  <h2 class="card-title">
    ➕ タスク追加
  </h2>

  <%= render "form",
      task: @task %>

</section>