<div class="page-container tasks-page">

  <div class="page-title">

    <h1>
      Tasks
    </h1>

    <p class="page-subtitle">
      今日のメインクエスト
    </p>

  </div>

  <section class="card">

    <div class="task-list">

      <% @tasks.each do |task| %>

        <div class="task-item">

          <h3>
            <%= task.title %>
          </h3>

          <p>
            <%= task.deadline %>
          </p>

        </div>

      <% end %>

    </div>

  </section>

</div>