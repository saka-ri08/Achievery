<div class="page-container free-tasks-page">

  <div class="page-title">
    <h1>FreeTask</h1>
    <p class="page-subtitle">
      自由に追加できるサブクエスト
    </p>
  </div>

  <section class="card">

    <%= render "tasks/task_list",
      tasks: @incomplete_free_tasks %>

    <%= render "tasks/task_list",
      tasks: @completed_free_tasks %>

  </section>

  <section class="card">
   <h2 class="card-title">➕タスク追加</h2>
    <%= render "tasks/form",
      task: @task %>
  </section>

</div>