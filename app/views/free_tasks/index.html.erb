<div class="page-container free-tasks-page">

  <div class="page-title">
    <h1>FreeTask</h1>
    <p class="page-subtitle">
      自由に追加できるサブクエスト
    </p>
  </div>

  <section class="card">

    <div class="free-task-list">

      <% @free_tasks.each do |task| %>

        <div class="free-task-item">
          <h3><%= task.title %></h3>
        </div>

      <% end %>

    </div>

  </section>

</div>