<h2>締切が近いタスク</h2>

<% if @urgent_tasks.any? %>

  <ul>

    <% @urgent_tasks.first(5).each do |task| %>

     <% days_left = (task.deadline - Date.current).to_i %>

     <li>

      <%= task.title %>

      <% if days_left < 0 %>

       ❌ 期限超過

      <% elsif days_left == 0 %>

       🔥 今日締切

      <% elsif days_left == 1 %>

       ⚠ 明日締切

      <% else %>

       📅 あと<%= days_left %>日

  <% end %>

     </li>

    <% end %>

  </ul>

<% else %>

  <p>締切設定されたタスクはありません。</p>

<% end %>