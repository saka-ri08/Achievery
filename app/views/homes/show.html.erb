<div class="page-container home-page">

  <section class="card greeting-card">
    <h2>
      おはようございます、<%= current_user.name %>さん
    </h2>

    <p>
      <%= Date.current.strftime("%Y/%m/%d") %>
    </p>
  </section>

  <div class="top-section">

    <section class="card today-schedule-card">
      <h3 class="card-title">
        今日の予定
      </h3>

      <% if @today_tasks.any? %>
        <ul class="card-list">
          <%= render "tasks/task_list",
           tasks: @today_tasks %>
        </ul>
      <% else %>
        <p>予定はありません。</p>
      <% end %>
    </section>

    <section class="card deadline-card">
      <h3 class="card-title">
        締切が近いタスク
      </h3>

      <% if @urgent_tasks.any? %>
        <ul class="card-list">

          <%= render "tasks/task_list",
      tasks: @urgent_tasks %>

        </ul>
      <% else %>
        <p>
          期限が近いタスクはありません。
        </p>
      <% end %>
       <%= link_to "タスク一覧へ", tasks_path %>
    </section>

  </div>

  <section class="card overdue-card">
   <h3>
     🔥 期限超過タスク
     (<%= @overdue_tasks.count %>件)
   </h3>

   <%= render "tasks/task_list",
       tasks: @overdue_tasks %>
 </section>

  <section class="card">

  <h3 class="card-title">
    📋 フリータスク
  </h3>

  <% if @free_tasks.any? %>

    <ul class="card-list">

      <%= render "tasks/task_list",
          tasks: @free_tasks.first(5) %>

    </ul>

    <%= link_to "もっと見る",
        free_tasks_path,
        class: "btn btn-secondary" %>

  <% else %>

    <p>
      フリータスクはありません。
    </p>

  <% end %>

</section>

  <section class="card">
   <h2 class="card-title">➕タスク追加</h2>
    <%= render "tasks/form",
      task: @task %>
  </section>

  <section class="card">

  <h3 class="card-title">
    🏆 実績解放状況
  </h3>

  <% if current_user.user_achievements.any? %>

    <ul class="card-list">

      <% current_user
          .user_achievements
          .last(3)
          .each do |ua| %>

        <li>
          <%= ua.achievement.name %>
        </li>

      <% end %>

    </ul>

  <% else %>

    <p>
      まだ実績がありません。
    </p>

  <% end %>

  <%= link_to "実績一覧へ",
      achievements_path,
      class: "btn btn-secondary" %>

</section>

</div>